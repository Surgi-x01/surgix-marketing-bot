# Surgi-X Marketing Bot — Environment Configuration
# Copy to .env and fill in your actual values

# === TELEGRAM ===
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# === CLAUDE API (Content Generation) ===
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# === BUFFER API (Publishing) ===
BUFFER_ACCESS_TOKEN=your_buffer_access_token_here

# === FIGMA API (Design Sync) ===
FIGMA_API_TOKEN=your_figma_api_token_here
FIGMA_FILE_ID=your_figma_file_id_here

# === ASSET & COURSE DIRECTORIES ===
# Local paths (development)
ASSET_DIR=/path/to/assets
COURSE_DIR=/path/to/course/materials

# For Render deployment, use cloud storage URLs or mount paths
# Example: ASSET_DIR=https://your-cloud-storage.com/assets

# === DEPLOYMENT ===
BOT_MODE=webhook
BOT_PORT=3000
NODE_ENV=production

# === VPS (Optional for self-hosted) ===
VPS_HOST=173.249.37.7
VPS_USER=root
VPS_PASSWORD=your_vps_password_here
